{
  "name": "Gobierno y Gestión de Datos - Laboratorio 1",

  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r requerimientos.txt",
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },

  "remoteUser": "vscode"
}
